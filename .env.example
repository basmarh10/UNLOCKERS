# Modèle de configuration : copier en .env (jamais commité) et adapter.

# Port du serveur Node (API + Socket.IO + fichiers statiques en production)
PORT=3000

# Fichier SQLite (créé automatiquement)
DB_FILE=./data/unlockers.db

# URL publique utilisée pour construire joinUrl et le QR code (/play?code=XXXX).
# En dev, mettre l'IP du PC pour tester sur un vrai téléphone : http://192.168.x.x:5174
PUBLIC_URL=http://localhost:5174

# Optionnel, pour les tests : surcharge des règles par défaut
# GAME_DURATION=300
# MAX_ERRORS=3
